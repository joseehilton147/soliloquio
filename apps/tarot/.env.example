# Solilóquio / tarot — variáveis de ambiente (EXEMPLO, sem segredos)
# Copie para `.env.local` em dev ou preencha no dashboard Cloudflare
# (Workers Builds: Settings → Variables and Secrets). NUNCA commite valores reais.

# Postgres em modo pooled (Transaction Mode, porta 6543 no Supabase).
# Onde obter: Supabase Dashboard → Project Settings → Database → Connection string (Transaction pooling).
# Em Workers, o Prisma precisa de driver HTTP (ex.: Prisma Accelerate); conexão TCP
# direta NÃO funciona no runtime workerd (sem sockets TCP de saída).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Postgres em modo direto (Session Mode, porta 5432). Usado só para migrations (`prisma migrate`).
# Onde obter: Supabase Dashboard → Project Settings → Database → Connection string (Direct connection).
# NÃO expor como secret do Worker em produção (só build/migrate local/CI).
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# URL pública da API tRPC (chamadas client-side).
# Onde obter: dev → http://localhost:3002 ; produção → https://<seu-dominio-ou-worker>.
NEXT_PUBLIC_API_URL="http://localhost:3002"

# URL pública canônica do app (metadata, OG tags, redirects).
# Onde obter: dev → http://localhost:3002 ; produção → https://<seu-dominio-ou-worker>.
NEXT_PUBLIC_APP_URL="http://localhost:3002"
